# Copy to .env and fill in the key. .env is gitignored. Never commit a key.
EHR_TRIAGE_BASE_URL=https://openrouter.ai/api/v1
EHR_TRIAGE_API_KEY=
# Systems 3 and 4. Which provider endpoint serves it is pinned in config/calibration.yaml (triage_provider).
EHR_TRIAGE_MODEL=z-ai/glm-5.3-flash
# The model that checks claims against their citations. Defaults to EHR_TRIAGE_MODEL when left out.
EHR_TRIAGE_JUDGE_MODEL=deepseek/deepseek-v4.1-flash-1017
